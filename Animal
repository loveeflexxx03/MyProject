package main

import "fmt"

// Animal — базовый тип
type Animal struct {
	Name string
}

// Speak выводит, какой звук издаёт животное
func (a Animal) Speak() {
	fmt.Printf("%s издает какой-то звук\n", a.Name)
}

// Dog встраивает Animal — это аналог наследования в Go
type Dog struct {
	Animal // анонимное (встроенное) поле
}

// Bark — собственный метод Dog
func (d Dog) Bark() {
	fmt.Printf("%s гавкает\n", d.Animal.Name)
}

func main() {
	dog := Dog{Animal{Name: "Rex"}}

	dog.Speak() // Rex издает какой-то звук — метод унаследован от Animal
	dog.Bark()  // Rex гавкает
}
